# Copy to harness/.env (gitignored). Never use personal keys here.
# Dedicated MidBrain agent for the harness (required). Doctor refuses keys that match a real-home key file.
MIDBRAIN_HARNESS_API_KEY=
# Second MidBrain agent used as the project-scoped credential for the isolation scenario (optional).
MIDBRAIN_HARNESS_PROJECT_API_KEY=
# Point at a non-production MidBrain API (optional; written as the global apiUrl in the throwaway home).
# MIDBRAIN_HARNESS_API_URL=https://stage.memory.midbrain.ai
# Client model providers.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional determinism / tuning knobs.
# MIDBRAIN_HARNESS_CLAUDE_MODEL=claude-sonnet-5
# MIDBRAIN_HARNESS_CODEX_MODEL=
# Pi is opt-in with --clients pi (or a comma-separated client list).
# MIDBRAIN_HARNESS_PI_VERSION=latest
# MIDBRAIN_HARNESS_PI_MODEL=claude-haiku-4-5
# MIDBRAIN_HARNESS_OPENCODE_VERSION=1.18.29
# MIDBRAIN_HARNESS_OPENCODE_MODEL=anthropic/claude-sonnet-4-5
# MIDBRAIN_HARNESS_HERMES_VERSION=0.19.0
# MIDBRAIN_HARNESS_HERMES_PROVIDER=anthropic
# MIDBRAIN_HARNESS_HERMES_MODEL=claude-sonnet-4-5
# MIDBRAIN_HARNESS_READBACK_TIMEOUT_MS=90000
# MIDBRAIN_HARNESS_INDEX_GRACE_MS=20000
# MIDBRAIN_HARNESS_TURN_TIMEOUT_MS=300000
# MIDBRAIN_HARNESS_ROOT=~/.midbrain-harness   (must be outside the temp dir)
# MIDBRAIN_HARNESS_PK=1                       (enables the legacy PK same-turn injection opt-in in hook env)

# NanoClaw (Node 24+, Docker, and Git required). Defaults clone/build the pinned source.
# Optional self-contained image: prepare-nanoclaw.mjs writes this manifest.
# Takes precedence over SOURCE/IMAGE below; image must already be built or loaded locally.
# MIDBRAIN_HARNESS_NANOCLAW_MANIFEST=/absolute/path/to/nanoclaw-package/nanoclaw-image.json
# MIDBRAIN_HARNESS_NANOCLAW_SOURCE=/absolute/path/to/clean/pinned/nanoclaw
# MIDBRAIN_HARNESS_NANOCLAW_IMAGE=midbrain-harness-nanoclaw:6656b326a900
# MIDBRAIN_HARNESS_NANOCLAW_MODEL=claude-sonnet-4-5
# Linux defaults to host networking; Docker Desktop defaults to its bridge/host alias.
# For a custom Docker network, provide API/registry URLs reachable inside that network.
# MIDBRAIN_HARNESS_NANOCLAW_NETWORK=your-network
# MIDBRAIN_HARNESS_CONTAINER_API_URL=http://memory-api:8000
# MIDBRAIN_HARNESS_CONTAINER_REGISTRY_URL=http://registry-host:4873/
